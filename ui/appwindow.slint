import { Button, VerticalBox, HorizontalBox, GridBox } from "std-widgets.slint";
import { Settings, AppSettings } from "settings_page.slint";

export component AppWindow inherits Window {
    in-out property <AppSettings> app_settings;
    in-out property <int> selected_page: 0;
    callback request-exit();
    callback request-save-settings(AppSettings);
    callback request-path-dialog(bool) -> string;   // If arg is true, open a Path dialog, else open a File dialog
    width: 1000px;
    height: 500px;
    default-font-size: 14px;

    HorizontalLayout {
        VerticalLayout {
            width: 200px;
            spacing: 0px;
            //col: 0;

            Button {
                max-height: 50px;
                text: "Backup";
                clicked => { selected_page = 0; }
            }
            Button {
                max-height: 50px;
                text: "Settings";
                clicked => { selected_page = 1; }
            }
            Button {
                max-height: 50px;
                text: "Exit GUI and daemon";
                clicked => {
                    root.request-exit();
                }
            }
        }
        
        VerticalLayout {
            if (selected_page == 0) : Text { text: "Content for Page 1"; }
            if (selected_page == 1) : Settings { 
                settings <=> app_settings;
                save-settings => {
                    selected_page = 0;
                    request-save-settings(self.settings);
                }
                open-path-dialog(openPathDialog) => {
                    request-path-dialog(openPathDialog)
                }
            }
        }
    }
}
