import { Button, VerticalBox, HorizontalBox, GridBox } from "std-widgets.slint";
import { Settings, AppSettings } from "settings_page.slint";
import { MainPage } from "main_page.slint";
import { BackupPage } from "backup_page.slint";

export component AppWindow inherits Window {
    in-out property <AppSettings> app_settings;
    in-out property <int> selected_page: 0;
    in-out property <float> backup_perc: 0;
    in-out property <string> backup_log: "";
    in-out property <bool> backup_completed: true;
    callback request-exit();
    callback request-save-settings(AppSettings);
    callback request-path-dialog(bool) -> string;   // If arg is true, open a Path dialog, else open a File dialog
    callback request-backup();
    min-width: 800px;
    min-height: 500px;
    default-font-size: 14px;
    title: @tr("Rust Backup");
    icon: @image-url("./Rust_logo.png");

    HorizontalLayout {
        VerticalLayout {
            width: 200px;
            spacing: 0px;
            visible: backup_completed;
            //col: 0;

            Button {
                max-height: 50px;
                text: "Backup";
                clicked => { selected_page = 0; }
            }
            Button {
                max-height: 50px;
                text: "Settings";
                clicked => { selected_page = 1; }
            }
            Button {
                max-height: 50px;
                text: "Exit GUI and daemon";
                clicked => {
                    root.request-exit();
                }
            }
        }
        
        VerticalLayout {
            if (selected_page == 0) : MainPage {
                backup => {
                    backup_perc = 0;
                    backup_completed = false;
                    selected_page = 2;
                    request-backup();
                }
            }
            if (selected_page == 1) : Settings { 
                settings <=> app_settings;
                save-settings => {
                    selected_page = 0;
                    request-save-settings(self.settings);
                }
                open-path-dialog(openPathDialog) => {
                    request-path-dialog(openPathDialog)
                }
            }
            if (selected_page == 2) : BackupPage {
                backup_completed <=> backup_completed;
                backup_perc <=> backup_perc;
                backup_log <=> backup_log;
            }
        }
    }
}
